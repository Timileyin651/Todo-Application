<!DOCTYPE html>
<html lang="en">
<%- include('../partials/head', { pageTitle: 'Edit task', extraCss: ['/css/tasks.css'] }) %>
<body>
  <%- include('../partials/navbar', { current: '' }) %>

  <main class="page-container page-container--narrow">
    <a class="back-link" href="/tasks">&larr; Back to all tasks</a>

    <%
      // Demo fallback so this page renders standalone; pass a real `task`
      // object ({ id, title, description, status }) from your route handler.
      const t = typeof task !== 'undefined' ? task : {
        id: 1,
        title: 'Design the onboarding flow',
        description: 'Sketch the three screens new users see before their first task.',
        status: 'In Progress'
      };
    %>

    <div class="form-card">
      <h2>Edit task</h2>
      <p class="subtitle">Only the status can change here</p>

      <% if (typeof error !== 'undefined' && error) { %>
        <div class="error-banner"><%= error %></div>
      <% } %>

      <div class="static-field">
        <span class="field-label">title</span>
        <p class="field-value field-value--title"><%= task.title %></p>
      </div>

      <% if (task.description) { %>
        <div class="static-field">
          <span class="field-label">description</span>
          <p class="field-value"><%= task.description %></p>
        </div>
      <% } %>

      <form action="/tasks/<%= task.id %>" method="POST" novalidate>
        <div class="field">
          <label for="status">status</label>
          <select id="status" name="status">
            <option value="Pending" <%= task.status === 'p' ? 'selected' : '' %>>Pending</option>
            <option value="Completed" <%= task.status === 'Completed' ? 'selected' : '' %>>Completed</option>
            <option value="Deleted" <%= task.status === 'Deleted' ? 'selected' : '' %>>Deleted</option>
          </select>
        </div>

        <div class="form-actions">
          <button type="submit" class="btn-primary">Save status</button>
          <a class="btn-outline" href="/tasks">Cancel</a>
        </div>
      </form>
    </div>
  </main>
</body>
</html>
